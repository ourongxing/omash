echo 'PASS: omash tun on and uninstall follow a revision that superseded theirs'
# The README path for the first TUN start: Settings -> Mihomo TUN -> Enter offers to install the missing
# helper and runs sudo in the same terminal. Cleanup removes whatever these scenarios install, whichever
# step fails, so it is registered before the first of them.
helper_installed=true
password_file=$home/.sudo-test-password
install -o "$uid" -g "$gid" -m600 /dev/null "$password_file"
python3 -c 'import secrets; print(secrets.token_urlsafe(18))' > "$password_file"
printf '%s:%s\n' "$user" "$(cat "$password_file")" | chpasswd
# Only this exact command, and only with the test user's password.
printf '%s ALL=(root) %s internal-tun-install %s %s %s %s\n' "$user" "$work/omash" "$uid" "$gid" "$data" "$hash" > "$sudoers"
sudoers_installed=true
chmod 440 "$sudoers"
visudo -cf "$sudoers"
# The TUI runs from $work/omash: setup elevates its own executable, the one the sudoers entry names.
run_in python3 "$work/check-tun-setup-ui.py" "$work/omash" decline
[[ ! -e /etc/omash-tun.json && ! -e /usr/local/libexec/omash-tun-service ]] || fail 'declining the installation in the TUI installed the helper'
run_in python3 "$work/check-tun-setup-ui.py" "$work/omash" cancel
[[ ! -e /etc/omash-tun.json && ! -e /usr/local/libexec/omash-tun-service ]] || fail 'a cancelled sudo prompt installed the helper'
require_state 'TUN must stay off after a declined or failed installation' "not s['tun_desired'] and not s['tun_active'] and s['running'] and s['backend'] == 'direct'"
run_in python3 "$work/check-tun-setup-ui.py" "$work/omash" install "$password_file"
[[ -e /etc/omash-tun.json && -e /usr/local/libexec/omash-tun-service ]] || fail 'the TUI did not install the helper'
wait_state 60 'TUN active after installing the helper from the TUI' "s['running'] and s['tun_active'] and s['backend'] == 'service' and not s['error'] and s['applied_revision'] == s['desired_revision']"
run_in python3 "$work/check-tun-traffic.py" tun
run_in "$home/omash" tun off
rm "$sudoers" "$password_file"
sudoers_installed=false
echo 'PASS: the TUI asks before installing the helper, keeps TUN off when declined or when sudo fails, and installs it through sudo in the same terminal'
# An explicitly supplied private profile can additionally exercise real remote proxies.
# It stays in the test user's private home and is removed by cleanup, never printed.
if [[ -n ${OMASH_TEST_PROFILE:-} ]]; then
  command -v slirp4netns >/dev/null
  run_in systemctl --user stop omash-supervisor.service
  ip -n "$ns" route del default
  ip -n "$ns" -6 route del default
  slirp4netns --netns-type=path --configure --disable-host-loopback --mtu=1500 --ready-fd=3 "/run/netns/$ns" tap0 3> "$work/slirp.ready" > "$work/slirp.log" 2>&1 &
  slirp_pid=$!
  for _ in {1..100}; do [[ ! -s $work/slirp.ready ]] || break; sleep .1; done
  [[ -s $work/slirp.ready ]]
  install -o "$uid" -g "$gid" -m600 "$OMASH_TEST_PROFILE" "$data/profiles/test.yaml"
  # Allow IPv4 fallback on a VM without native IPv6; dual-stack behavior was proven above.
  run_in "$home/omash" tun on > "$work/private-result.txt" 2>&1 || { echo 'Private profile activation failed; details kept on test VM' >&2; exit 1; }
  run_in curl --noproxy '*' -4 -fsS --max-time 45 https://www.gstatic.com/generate_204 -o /dev/null
  # Match the exact socket tuple and require a remote leaf on that same TUN flow.
  run_in python3 "$work/check-tun-traffic.py" remote
  run_in "$home/omash" tun off > /dev/null
fi
run_in systemctl --user stop omash-supervisor.service
