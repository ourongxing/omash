# Setup runs sudo for exactly one command and the later uninstall for another; authorize only those two.
{
  printf '%s ALL=(root) NOPASSWD: %s internal-tun-install %s %s %s %s\n' "$user" "$work/omash" "$uid" "$gid" "$data" "$hash"
  printf '%s ALL=(root) NOPASSWD: %s internal-tun-uninstall %s\n' "$user" "$work/omash" "$uid"
} > "$sudoers"
sudoers_installed=true
chmod 440 "$sudoers"
visudo -cf "$sudoers"
# (A pty makes setup choose sudo even where pkexec exists; a sudoers mismatch would wait for a password, hence the timeout.)
run_in timeout --foreground 180 script -q -e -c "'$work/omash' tun setup" /dev/null > "$work/setup.log" 2>&1 || { cat "$work/setup.log" >&2; exit 1; }
grep -q 'TUN helper installed for UID' "$work/setup.log"
[[ $(systemctl show -p MainPID --value omash-tun.service) != "$helper_main" ]] || fail 'omash tun setup did not replace the running helper'
[[ $(run_in systemctl --user show -p MainPID --value omash-supervisor.service) == "$supervisor_main" ]] || fail 'omash tun setup restarted a supervisor that runs the installed binary'
# An upgrade installs a new client binary under the running supervisor, which keeps the old build, and
# with it the old helper protocol, until it is restarted. The installer leaves that restart to setup.
install -o "$uid" -g "$gid" -m755 "$binary" "$home/omash"
[[ $(readlink "/proc/$supervisor_main/exe") == *' (deleted)' ]] || fail 'replacing the client did not leave the supervisor on a deleted binary'
run_in timeout --foreground 180 script -q -e -c "'$work/omash' tun setup" /dev/null > "$work/setup-upgrade.log" 2>&1 || { cat "$work/setup-upgrade.log" >&2; exit 1; }
restarted=$(run_in systemctl --user show -p MainPID --value omash-supervisor.service)
[[ $restarted =~ ^[0-9]+$ && $restarted -gt 1 && $restarted != "$supervisor_main" ]] || fail 'omash tun setup did not restart a supervisor running a replaced binary'
[[ $(readlink "/proc/$restarted/exe") != *' (deleted)' ]] || fail 'the restarted supervisor still runs a deleted binary'
grep -q 'Restarted the supervisor' "$work/setup-upgrade.log" || fail 'omash tun setup did not report the supervisor restart'
run_in "$home/omash" tun on
echo 'PASS: omash tun setup upgrades the helper through a sudoers-authorized exact command and restarts a supervisor left on a replaced binary'
