import json,sys
s=json.load(open(sys.argv[1])); assert s['active'] and s['supervisor']['backend']=='service' and s['supervisor']['error']
PY
cp "$work/good.yaml" "$data/profiles/test.yaml"; chown "$uid:$gid" "$data/profiles/test.yaml"
run_in "$home/omash" tun on
# Only the helper retries a failed removal of its firewall exception, so uninstall must keep it until the
# removal is confirmed. The helper runs as the test user: making nft executable by root only breaks its
# nft calls, while this script (root) can still list the rules. Cleanup restores the mode if needed.
ip netns exec "$ns" nft list table inet omash_test_firewall | grep "omash-tun:$uid:input" >/dev/null || fail 'no firewall exception before the failing uninstall'
nft_restore_mode=$(stat -c %a "$nft_program")
chmod 0700 "$nft_program"
if run_in script -q -e -c "'$work/omash' tun uninstall" /dev/null > "$work/uninstall-firewall.log" 2>&1; then fail 'uninstall removed a helper that could not remove its firewall exception'; fi
grep -q 'could not remove its firewall exceptions' "$work/uninstall-firewall.log" || fail "uninstall failed for another reason: $(tr -d '\r' < "$work/uninstall-firewall.log" | tail -n 3)"
[[ -e /etc/omash-tun.json && -e /usr/local/libexec/omash-tun-service ]] || fail 'uninstall removed the helper although it could not remove its firewall exception'
ip netns exec "$ns" nft list table inet omash_test_firewall | grep "omash-tun:$uid:input" >/dev/null || fail 'the firewall exception vanished although the helper could not run nft'
status_ok "s['helper']['firewall_error'] and not s['active'] and s['supervisor']['backend'] == 'direct'" || fail 'the kept helper does not report its firewall error'
chmod "$nft_restore_mode" "$nft_program"
nft_restore_mode=
# The helper retries every two seconds.
for _ in {1..50}; do
  if ! ip netns exec "$ns" nft list table inet omash_test_firewall | grep "omash-tun:$uid:input" >/dev/null; then break; fi
  sleep .2
done
if ip netns exec "$ns" nft list table inet omash_test_firewall | grep "omash-tun:$uid:input" >/dev/null; then fail 'the kept helper did not remove its exception once nft worked again'; fi
echo 'PASS: uninstall keeps a helper that cannot remove its firewall exception, and the helper removes it once nft works again'
# Also uninstall follows a revision that superseded its own instead of timing out and keeping the helper.
supersede "$work/uninstall-success.log" script -q -e -c "'$work/omash' tun uninstall" /dev/null
followed "$work/uninstall-success.log" || fail 'omash tun uninstall did not follow the revision that superseded its own'
helper_installed=false
[[ ! -e /etc/omash-tun.json && ! -e /usr/local/libexec/omash-tun-service ]]
run_in "$home/omash" tun status > "$work/uninstall-success.json"
python3 - "$work/uninstall-success.json" <<'PY'
import json,sys
s=json.load(open(sys.argv[1])); v=s['supervisor']
assert not s['desired'] and not s['active'] and v['running'] and v['backend']=='direct'
assert not v['tun_active'] and not v['error'] and v['desired_revision']==v['applied_revision']
PY
