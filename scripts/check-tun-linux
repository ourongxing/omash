cp "$work/good.yaml" "$data/profiles/test.yaml"; chown "$uid:$gid" "$data/profiles/test.yaml"
run_in "$home/omash" tun on
echo 'PASS: a rejected configuration reports the core reason and leaves the running core untouched'
# A running core may only exclude its own exact rules, even when Apply changes indices.
for conflict in table priority active-rule active-route; do
  run_in "$home/omash" tun status > "$work/before-conflict.json"
  cp "$data/runtime.yaml" "$work/before-conflict.yaml"
  case $conflict in
    table) sed -i '/  mtu: 1500/a\  iproute2-table-index: 199' "$data/profiles/test.yaml" ;;
    priority) sed -i '/  mtu: 1500/a\  iproute2-rule-index: 20000' "$data/profiles/test.yaml" ;;
    active-rule)
      ip -n "$ns" -6 rule add priority 9001 to 2001:db8:ffff::/64 table 199
      sed -i 's/mtu: 1500/mtu: 1450/' "$data/profiles/test.yaml" ;;
    active-route)
      ip -n "$ns" route add 203.0.113.64/26 dev vpn-test table 2022
      sed -i 's/mtu: 1500/mtu: 1450/' "$data/profiles/test.yaml" ;;
  esac
  if run_in "$home/omash" tun on > "$work/conflict-$conflict.log" 2>&1; then echo "running Apply accepted $conflict conflict" >&2; exit 1; fi
  run_in "$home/omash" tun status > "$work/after-conflict.json"
  python3 - "$work/before-conflict.json" "$work/after-conflict.json" <<'PY'
import json,sys
before,after=(json.load(open(p)) for p in sys.argv[1:])
assert after['active'] and after['supervisor']['error']
for key in ('pid','revision','generation'): assert before['helper'][key]==after['helper'][key], key
assert before['supervisor']['applied_revision']==after['supervisor']['applied_revision']
PY
  cmp "$work/before-conflict.yaml" "$data/runtime.yaml"
  ip -n "$ns" rule show | grep '20000:.*lookup 199' >/dev/null
  ip -n "$ns" route show table 199 | grep 'blackhole 203.0.113.128/25' >/dev/null
  case $conflict in
    active-rule)
      ip -n "$ns" -6 rule show | grep '9001:.*lookup 199' >/dev/null
      ip -n "$ns" -6 rule del priority 9001 to 2001:db8:ffff::/64 table 199 ;;
    active-route)
      ip -n "$ns" route show table 2022 | grep '203.0.113.64/26 dev vpn-test' >/dev/null
      ip -n "$ns" route del 203.0.113.64/26 dev vpn-test table 2022 ;;
  esac
  cp "$work/good.yaml" "$data/profiles/test.yaml"; chown "$uid:$gid" "$data/profiles/test.yaml"
  run_in "$home/omash" tun on
done
echo 'PASS: running Apply rejects foreign tables, priorities and added rules/routes without stopping the core'
# C6: kill -9 of the helper's Mihomo leaves its policy rules behind. The helper must recognise them as its
# own so the supervisor's normal retry brings TUN back (it used to fail forever with "conflicts with
# existing rules").
run_in "$home/omash" tun status > "$work/c6-before.json"
mpid=$(json_val "s['helper']['pid']" < "$work/c6-before.json")
ip -n "$ns" -4 rule show | sort > "$work/c6-rules4.before"
ip -n "$ns" -6 rule show | sort > "$work/c6-rules6.before"
killed_at=$SECONDS
kill -9 "$mpid"
residue=$(ip -n "$ns" -4 rule show | grep -c 'lookup 2022' || true)
echo "C6: killed Mihomo pid $mpid; $residue IPv4 rules still point at table 2022 right after the kill (informational)"
wait_state 30 'TUN restored by the automatic retry after kill -9' "s['tun_active'] and s['running'] and s['pid'] != $mpid and not s['error'] and s['applied_revision'] == s['desired_revision']"
echo "C6: TUN active again $((SECONDS - killed_at))s after the kill"
diff -u "$work/c6-rules4.before" <(ip -n "$ns" -4 rule show | sort)
diff -u "$work/c6-rules6.before" <(ip -n "$ns" -6 rule show | sort)
run_in python3 "$work/check-tun-traffic.py" tun
echo 'PASS: kill -9 of Mihomo self-heals: the residue rules are removed and the same rule set returns'
# C6 safety: rules the helper does not own must never be deleted. Pause the supervisor so that nothing
# retries, kill Mihomo, plant a foreign rule at a residue priority, then let the supervisor try again.
mpid=$(status_val "s['helper']['pid']")
sup=$(run_in systemctl --user show -p MainPID --value omash-supervisor.service)
[[ $sup =~ ^[0-9]+$ && $sup -gt 1 ]] || fail "cannot find the supervisor main PID (got '$sup')"
paused_pid=$sup
kill -STOP "$sup"
kill -9 "$mpid"
sleep 1
residue=$(ip -n "$ns" -4 rule show | grep -c 'lookup 2022' || true)
foreign_checked=false
if ((residue == 0)); then
  echo 'NOTE: kill -9 left no IPv4 residue (the helper heals eagerly?); skipping the foreign-rule check'
  kill -CONT "$sup"; paused_pid=
  wait_state 30 'TUN restored after the second kill -9' "s['tun_active'] and s['running'] and s['pid'] != $mpid and not s['error'] and s['applied_revision'] == s['desired_revision']"
else
  ip -n "$ns" rule add priority 9001 to 203.0.113.200/32 table 199
  ip -n "$ns" -4 rule show | sort > "$work/c6-rules4.planted"
  run_in "$home/omash" tun doctor > "$work/c6-doctor.txt" 2>&1
  diff -u "$work/c6-rules4.planted" <(ip -n "$ns" -4 rule show | sort) || fail 'omash tun doctor changed policy rules'
  kill -CONT "$sup"; paused_pid=
  wait_state 20 'a conflict error instead of deleting rules that are not ours' "'conflicts with existing rules' in (s['error'] or '') and not s['tun_active']"
  diff -u "$work/c6-rules4.planted" <(ip -n "$ns" -4 rule show | sort) || fail 'the helper deleted IPv4 rules although a foreign rule shares their priorities'
  ip -n "$ns" rule del priority 9001 to 203.0.113.200/32 table 199
  foreign_checked=true
  run_in "$home/omash" tun on
fi
require_state 'TUN did not return once the foreign rule was gone' "s['tun_active'] and s['running'] and not s['error'] and s['applied_revision'] == s['desired_revision']"
diff -u "$work/c6-rules4.before" <(ip -n "$ns" -4 rule show | sort)
diff -u "$work/c6-rules6.before" <(ip -n "$ns" -6 rule show | sort)
run_in python3 "$work/check-tun-traffic.py" tun
if [[ $foreign_checked == true ]]; then
  echo 'PASS: leftover rules sharing a priority with a foreign rule are not deleted; TUN returns once the conflict is gone'
fi
# C7: with the default fake-ip DNS an address handed out before a core restart must still work after it.
sed '/enhanced-mode: redir-host/d' "$work/good.yaml" > "$data/profiles/test.yaml"
run_in "$home/omash" tun on
grep -q 'enhanced-mode: fake-ip' "$data/runtime.yaml" || fail 'the variant profile did not default to fake-ip'
grep -q 'store-fake-ip: true' "$data/runtime.yaml" || fail 'fake-ip mappings are not stored across restarts'
