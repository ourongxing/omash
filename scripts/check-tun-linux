run_in "$home/omash" tun on
echo 'PASS: fake-IP mappings survive a core restart'
# A second same-UID client cannot replace the active supervisor's generation.
run_in python3 - "$data/runtime.yaml" <<'PY'
import json,socket,struct,sys
path='/run/omash-tun/control.sock'
def read(s):
 b=s.recv(4); assert len(b)==4
 n=struct.unpack('!I',b)[0]; data=b''
 while len(data)<n: data+=s.recv(n-len(data))
 return json.loads(data)
def send(s,obj):
 b=json.dumps(obj).encode(); s.sendall(struct.pack('!I',len(b))+b); return read(s)
s=socket.socket(socket.AF_UNIX); s.connect(path)
r=send(s,dict(version=2,id='second',action=dict(command='start',yaml=open(sys.argv[1]).read(),validate_only=False)))
assert 'another supervisor' in r['error'] and r['status']['running']; s.close()
s=socket.socket(socket.AF_UNIX); s.connect(path)
r=send(s,dict(version=999,id='version',action=dict(command='hello'))); assert 'protocol mismatch' in r['error']; s.close()
s=socket.socket(socket.AF_UNIX); s.connect(path); s.settimeout(3); s.sendall(struct.pack('!I',16*1024*1024+1))
try: assert s.recv(1)==b''
except ConnectionResetError: pass
s.close()
PY
# Root can reach the socket path, but is not the registered peer UID.
