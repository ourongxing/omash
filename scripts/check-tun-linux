# C1: a failure on the very first attempt after a supervisor start must be retried automatically
# (it used to stay down until the next explicit request).
run_in systemctl --user stop omash-supervisor.service
ip netns exec "$ns" python3 -c 'import socket,time; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(("127.0.0.1",19090)); s.listen(); time.sleep(300)' &
